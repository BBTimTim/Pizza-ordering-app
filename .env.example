# Docker Compose beállítások – másold le .env néven: cp .env.example .env
# Minden értéknek van alapértelmezése, így .env nélkül is elindul.

APP_PORT=8080
APP_ENV=local
APP_DEBUG=true
# Üresen hagyva az első indításkor automatikusan generálódik
APP_KEY=

DB_DATABASE=onemoreslice
DB_USERNAME=onemoreslice
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_PORT=3307

# Opcionális – nélkülük a térkép és az EmailJS-es levelek nem működnek, de az oldal igen
VITE_GOOGLE_API_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_TEMPLATE_ID2=
VITE_EMAILJS_PUBLIC_KEY=

# Stripe teszt mód (https://dashboard.stripe.com/test/apikeys) – nélküle a rendelés nem fizethető ki
STRIPE_SECRET=
VITE_STRIPE_PUBLIC_KEY=
