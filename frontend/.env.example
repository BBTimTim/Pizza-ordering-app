# Frontend beállítások Docker nélküli futtatáshoz (npm run dev) – másold le .env néven.
# CSAK publikus értékek! Minden VITE_ változó a böngészőbe kerül, titkos kulcs (sk_...) ide soha.

# Backend címe (Docker nélkül: php artisan serve)
VITE_API_URL=http://127.0.0.1:8000/api
VITE_IMG_URL=http://127.0.0.1:8000/uploads

# Stripe publikus teszt kulcs (pk_test_...)
VITE_STRIPE_PUBLIC_KEY=

# Google Maps (térkép)
VITE_GOOGLE_API_KEY=

# EmailJS (kapcsolati űrlap)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
