{
  "AlarmName": "one-more-slice-5xx-hibak",
  "AlarmDescription": "Riasztás: 5 percen belül legalább 5 szerverhiba (5xx) a load balancer mögötti alkalmazásban",
  "Namespace": "AWS/ApplicationELB",
  "MetricName": "HTTPCode_Target_5XX_Count",
  "Dimensions": [
    { "Name": "LoadBalancer", "Value": "app/one-more-slice/0123456789abcdef" }
  ],
  "Statistic": "Sum",
  "Period": 300,
  "EvaluationPeriods": 1,
  "Threshold": 5,
  "ComparisonOperator": "GreaterThanOrEqualToThreshold",
  "TreatMissingData": "notBreaching",
  "AlarmActions": ["arn:aws:sns:eu-central-1:123456789012:one-more-slice-riasztasok"]
}
