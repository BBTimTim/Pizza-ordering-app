{
  "AlarmName": "one-more-slice-nem-egeszseges-peldany",
  "AlarmDescription": "Riasztás: legalább egy példány 2 egymást követő percben nem válaszol a /api/health ellenőrzésre",
  "Namespace": "AWS/ApplicationELB",
  "MetricName": "UnHealthyHostCount",
  "Dimensions": [
    { "Name": "LoadBalancer", "Value": "app/one-more-slice/0123456789abcdef" },
    { "Name": "TargetGroup", "Value": "targetgroup/one-more-slice/0123456789abcdef" }
  ],
  "Statistic": "Maximum",
  "Period": 60,
  "EvaluationPeriods": 2,
  "Threshold": 1,
  "ComparisonOperator": "GreaterThanOrEqualToThreshold",
  "TreatMissingData": "notBreaching",
  "AlarmActions": ["arn:aws:sns:eu-central-1:123456789012:one-more-slice-riasztasok"]
}
