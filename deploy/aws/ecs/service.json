{
  "cluster": "one-more-slice",
  "serviceName": "one-more-slice",
  "taskDefinition": "one-more-slice",
  "launchType": "FARGATE",
  "desiredCount": 2,
  "deploymentConfiguration": {
    "minimumHealthyPercent": 100,
    "maximumPercent": 200,
    "deploymentCircuitBreaker": { "enable": true, "rollback": true }
  },
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["subnet-0aaaaaaaaaaaaaaaa", "subnet-0bbbbbbbbbbbbbbbb"],
      "securityGroups": ["sg-0cccccccccccccccc"],
      "assignPublicIp": "ENABLED"
    }
  },
  "loadBalancers": [
    {
      "targetGroupArn": "arn:aws:elasticloadbalancing:eu-central-1:123456789012:targetgroup/one-more-slice/0123456789abcdef",
      "containerName": "web",
      "containerPort": 80
    }
  ],
  "healthCheckGracePeriodSeconds": 60
}
